# ============================================================================
# 金泰 AI 内容安全防火墙网关 (:4300) 环境变量配置模板
# 使用说明：复制为 .env 后填入阿里大区经理开通的 AccessKey 即可激活 L2 线上终审
# ============================================================================

# 1. 服务监听端口与审计数据库路径 (法定留存 >= 6 个月)
JINTAI_FIREWALL_PORT=4300
JINTAI_FIREWALL_DB=/app/data/jintai_firewall_audit.db

# 2. 国家强制标准 GB 45438-2025 显隐式数字水印 HMAC 签名密钥
JINTAI_WATERMARK_SECRET=JINTAI-AIGC-GB45438-2026-PROD-SECRET

# 3. L1 本地 AI 护栏层（指向 A 机 172.16.0.10:8000 的 Qwen3Guard-Gen-4B，0 API 费）
JINTAI_ENABLE_LIVE_L1=1
JINTAI_L1_GUARD_URL=http://172.16.0.10:8000/v1/chat/completions
JINTAI_L1_GUARD_MODEL=Qwen/Qwen3Guard-Gen-4B

# 4. L2 阿里云内容安全增强版 2.0（只买通用容量预付费资源包，只调 text_standard 与 baselineCheck）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_GREEN_ENDPOINT=https://green-cip.cn-shanghai.aliyuncs.com
